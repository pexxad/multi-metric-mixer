APP_RELEASE=1.0.0
HOST=127.0.0.1
PORT=3000
# npm run devではBrowserがVite (5173) に接続し、/auth・/apiをBFFへproxyします。
PUBLIC_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Required explicit provider instance key. Configure its OIDC metadata separately.
AUTH_PROVIDER_KEY=oidc-main
AUTH_PROVIDER_LABEL=Organization sign-in
SESSION_TTL_SECONDS=28800
SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_TRANSACTION_SECRET=replace-with-a-different-32-character-secret
OIDC_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_example
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me-if-the-client-is-confidential
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_SCOPES=openid email profile
OIDC_GROUPS_CLAIM=cognito:groups
OIDC_ADMIN_GROUP=multi-metric-mixer-admins
OIDC_LOGOUT_MODE=cognito
OIDC_LOGOUT_ENDPOINT=https://example.auth.ap-northeast-1.amazoncognito.com/logout
OIDC_ALLOW_HTTP_LOOPBACK=false

# Agent model. A local OpenAI-compatible API may use loopback HTTP; any non-loopback endpoint must use HTTPS.
AGENT_PROVIDER=disabled
# AGENT_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_COMPATIBLE_ALLOW_INSECURE_HTTP=false
# OPENAI_COMPATIBLE_MODEL=replace-with-model-identifier
# OPENAI_COMPATIBLE_API_KEY=optional
# OPENAI_COMPATIBLE_TIMEOUT_MS=60000
# OPENAI_COMPATIBLE_MAX_TOKENS=8192
# OPENAI_COMPATIBLE_CONTEXT_WINDOW_TOKENS=32768
# OPENAI_COMPATIBLE_REASONING_EFFORT=medium

# Never expose or proxy this Backend listener. MCP and the internal API share it.
BACKEND_PORT=3001
BACKEND_CALLER_ORIGIN=http://127.0.0.1:3000
BACKEND_AUDIENCE=http://127.0.0.1:3001
BACKEND_TOKEN_ISSUER=multi-metric-mixer-bff
BACKEND_TOKEN_KEY_ID=bff-1
# Reusable short-lived access token. Allowed range: 5-86400 seconds; keep production values short.
BACKEND_TOKEN_TTL_SECONDS=300
# Ed25519 PKCS#8 private key and SPKI public key, DER encoded then Base64.
BACKEND_TOKEN_PRIVATE_KEY_BASE64=replace-with-bff-only-private-key
BACKEND_TOKEN_PUBLIC_KEY_BASE64=replace-with-backend-only-public-key

BFF_STORAGE_DRIVER=sqlite
BFF_DATA_DIR=.data
BACKEND_STORAGE_DRIVER=sqlite
BACKEND_DATA_DIR=.data
DATA_CONNECTION_PROFILES_FILE=.data/connection-profiles.json
# Production uses separate PostgreSQL databases and requires all of the following:
# BFF_DATABASE_URL_SECRET_ID=multi-metric-mixer/production/bff-database
# BACKEND_DATABASE_URL_SECRET_ID=multi-metric-mixer/production/backend-database
# AWS_REGION=ap-northeast-1
# ARTIFACT_BUCKET=replace-me
# ARTIFACT_PREFIX=production
# ARTIFACT_KMS_KEY_ID=replace-me

API_BODY_BYTES=262144
UPLOAD_BYTES=10485760
SOURCE_RESPONSE_BYTES=2097152
SOURCE_ROWS=5000
JSON_DEPTH=32
CONCURRENT_RUNS_PER_WORKSPACE=2
JOIN_ROWS=100000
ARTIFACT_STORAGE_BYTES=1073741824
ARTIFACT_RETENTION_DAYS=30

# Local mock server only. Leave both empty in AWS production.
SOURCE_ALLOWED_PRIVATE_HOSTS=127.0.0.1
SOURCE_ALLOWED_HTTP_HOSTS=127.0.0.1
