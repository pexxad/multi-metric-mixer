APP_RELEASE=1.0.0-local
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

AUTH_PROVIDER_KEY=local-keycloak
AUTH_PROVIDER_LABEL=Local Keycloak
SESSION_TTL_SECONDS=28800
SESSION_SECRET=local-session-secret-change-before-real-use
AUTH_TRANSACTION_SECRET=local-transaction-secret-change-before-real-use
OIDC_ISSUER=http://127.0.0.1:8080/realms/multi-metric-mixer
OIDC_CLIENT_ID=multi-metric-mixer
OIDC_CLIENT_SECRET=local-client-secret
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_SCOPES=openid email profile
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=multi-metric-mixer-admins
OIDC_LOGOUT_MODE=oidc
OIDC_LOGOUT_USE_ID_TOKEN_HINT=false
OIDC_ALLOW_HTTP_LOOPBACK=true

# OpenAI互換APIを用意するまではdisabledのまま起動できます。接続時はREADMEの手順に従って変更します。
AGENT_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=http://192.168.1.252:1234/v1
OPENAI_COMPATIBLE_ALLOW_INSECURE_PRIVATE_HTTP=true
OPENAI_COMPATIBLE_MODEL=google/gemma-4-e4b
OPENAI_COMPATIBLE_API_KEY=optional
OPENAI_COMPATIBLE_TIMEOUT_MS=300000
OPENAI_COMPATIBLE_MAX_TOKENS=8192
OPENAI_COMPATIBLE_CONTEXT_WINDOW_TOKENS=131072

BACKEND_PORT=3001
BACKEND_CALLER_ORIGIN=http://127.0.0.1:3000
BACKEND_AUDIENCE=http://127.0.0.1:3001
BACKEND_TOKEN_ISSUER=multi-metric-mixer-bff
BACKEND_TOKEN_KEY_ID=local-bff-1
BACKEND_TOKEN_TTL_SECONDS=15
# npm run localが起動ごとにEd25519鍵を生成し、BFFには秘密鍵、Backendには公開鍵として設定します。

BFF_STORAGE_DRIVER=sqlite
BFF_DATA_DIR=.data
BACKEND_STORAGE_DRIVER=sqlite
BACKEND_DATA_DIR=.data
DATA_SOURCE_SECRET_PROVIDER=file
DATA_SOURCE_SECRET_FILE=.data/local-source-secrets.json

API_BODY_BYTES=262144
UPLOAD_BYTES=10485760
SOURCE_RESPONSE_BYTES=2097152
SOURCE_ROWS=5000
JSON_DEPTH=32
CONCURRENT_RUNS_PER_WORKSPACE=2
JOIN_ROWS=100000
ARTIFACT_STORAGE_BYTES=1073741824
ARTIFACT_RETENTION_DAYS=30

SOURCE_ALLOWED_PRIVATE_HOSTS=127.0.0.1
SOURCE_ALLOWED_HTTP_HOSTS=127.0.0.1
